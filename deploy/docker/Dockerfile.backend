# Multi-stage Docker build for KREA IT NOC Go Backend
FROM golang:alpine AS builder

WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /krea-noc ./cmd/server

# Final runtime image
FROM alpine:3.20

WORKDIR /app

# Copy root CA certificates from builder stage (avoids external apk CDN network calls)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

ENV TZ=Asia/Kolkata

COPY --from=builder /krea-noc /app/krea-noc
COPY backend/migrations /app/migrations

EXPOSE 8080

ENTRYPOINT ["/app/krea-noc"]
