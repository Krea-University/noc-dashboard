APP_NAME=KREA IT NOC
APP_ENV=production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# Database Configuration (MySQL 8 / MariaDB 11)
DB_HOST=db
DB_PORT=3306
DB_NAME=krea_noc
DB_USER=krea_noc
DB_PASSWORD=your_secure_db_password_here

# Auth & Session Security
SESSION_SECRET=generate_a_random_32_byte_secret_key_here
JWT_EMBED_SECRET=generate_a_random_embed_jwt_secret_key_here

# Bootstrap Initial Admin (Created on first run if no users exist)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=YourSecureAdminPassword123!
BOOTSTRAP_ADMIN_EMAIL=noc-admin@example.edu

# ManageEngine OpManager Integration
OPMANAGER_URL=https://opmanager.example.edu
OPMANAGER_API_KEY=your_opmanager_api_key_here
OPMANAGER_VERIFY_TLS=false

# ManageEngine Endpoint Central Integration
ENDPOINT_CENTRAL_URL=https://endpointcentral.example.edu:8383
ENDPOINT_CENTRAL_API_KEY=your_endpoint_central_api_key_here
ENDPOINT_CENTRAL_VERIFY_TLS=false

# FortiGate Firewall Integration
FORTIGATE_URL=https://firewall.example.edu:5551
FORTIGATE_API_TOKEN=your_fortigate_api_token_here
FORTIGATE_VERIFY_TLS=false

# Biometric Group in OpManager (Lite Devices)
BIOMETRIC_DEVICE_GROUP=IoT

# Polling Intervals (Seconds)
POLL_OPMANAGER_DEVICES_SECONDS=30
POLL_OPMANAGER_ALARMS_SECONDS=15
POLL_OPMANAGER_METRICS_SECONDS=30
POLL_ENDPOINT_CENTRAL_SECONDS=60
POLL_FORTIGATE_SECONDS=30

# TV Display Settings
TV_ROTATION_SECONDS=30
DISPLAY_IDLE_TIMEOUT_MINUTES=30

# Sound Alert System
SOUND_ALERTS_ENABLED=true

# Logging
LOG_LEVEL=info

# CORS & ERP Iframe Embedding Restrictions
NOC_ALLOWED_ORIGINS=https://erp.example.edu,http://localhost:5173,http://localhost:8080
NOC_EMBED_ALLOWED_ORIGINS=https://erp.example.edu

# Mock Mode (Set to true to run fully self-contained realistic simulation without external APIs)
MOCK_MODE=false
